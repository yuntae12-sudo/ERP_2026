<?xml version="1.0"?>
<launch>
<include file="$(find nmea_navsat_driver)/launch/nmea_serial_driver.launch">
  <arg name="port" value="/dev/ttyUSB1"/>
  <arg name="baud" value="115200"/>
</include>
<arg name="frame_id" default="vectornav"/>

<node pkg="vectornav" type="vnpub" name="vectornav" output="screen" >
	<param name="frame_id" value="$(arg frame_id)"/>

	<rosparam command="load" file="$(find vectornav)/params/vn200.yaml" />
</node>	
	
</launch>


